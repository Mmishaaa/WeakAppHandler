# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored; never commit real secrets.
#
# This file will grow as later tasks introduce each service's configuration
# (Auth, JWT signing, etc. per PRD §11).

COMPOSE_PROJECT_NAME=weakapphandler

# WeakApp (third_party/weak-app) -- see THIRD_PARTY.md
WEAKAPP_PORT=8080

# PostgreSQL -- superuser credentials for the compose-managed instance only.
# Per-service least-privilege roles (processor_rw/auth_rw/notification_rw/gateway_ro) are created
# by deploy/postgres/init/ (TASK-043) and match the credentials already hardcoded in each service's
# appsettings.json; gateway_ro holds SELECT only, so it is structurally unable to write anything.
POSTGRES_DB=weakapphandler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# RabbitMQ -- only ports are configurable here, deliberately. RABBITMQ_DEFAULT_USER/PASS are
# NOT listed because they would be silently ignored: once rabbitmq.conf sets
# `management.load_definitions`, RabbitMQ logs "Will not seed default virtual host and user:
# have definitions to load..." and skips default-user creation entirely, so those two env vars
# have no effect at all. Per-service least-privilege users and the dedicated "weakapphandler" vhost
# live in deploy/rabbitmq/definitions.json (TASK-043); "guest" no longer exists. A separate "admin"
# user (also in definitions.json) is the human/ops login for the management UI.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application services (TASK-047) -- host ports published for direct/local access. In-network
# connection strings, JWKS/service URLs and RabbitMQ hosts are wired to compose service names
# directly in docker-compose.yml (not overridable here); only the host-side published port is.
AUTH_PORT=8081
INGESTOR_PORT=8082
PROCESSOR_PORT=8083
GATEWAY_PORT=8084
NOTIFICATION_PORT=8085
FRONTEND_PORT=8086

# Observability (TASK-045/TASK-047).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Retention job (TASK-048): how long raw readings/ingest_batches/processed_messages are kept
# before being rolled up into readings_hourly and deleted, and how often the job runs.
RETENTION_WINDOW_DAYS=30
RETENTION_INTERVAL_MINUTES=60
