# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored; never commit real secrets.

COMPOSE_PROJECT_NAME=weakapphandler
ASPNETCORE_ENVIRONMENT=Development

# WeakApp, the unstable third-party API.
WEAKAPP_PORT=8080
WEAKAPP_API_KEY=supersecret

# RabbitMQ. Host ports only — inside the backend network the broker is always rabbitmq:5672.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# PostgreSQL. Host port only — inside the backend network the database is always postgres:5432.
# POSTGRES_USER owns the schema and runs the migrations.
POSTGRES_PORT=5432
POSTGRES_DB=weakapphandler
POSTGRES_USER=processor
POSTGRES_PASSWORD=processor_password

# Read-only role for the GraphQL gateway. Created by db/init on first start.
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=gateway_password

# pgAdmin, the database UI.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@weakapphandler.com
PGADMIN_PASSWORD=admin

# Host ports for our own services. Inside the network every one of them listens on 8080.
INGESTOR_PORT=5227
PROCESSOR_PORT=5242
GATEWAY_PORT=5243
NOTIFICATIONS_PORT=5244

# The dashboard. nginx serves it and proxies the three backends under the same origin.
FRONTEND_PORT=5180

# Browser origin allowed to open a SignalR connection to the notification service. Only the
# Vite dev server needs it; the container talks to the hub through nginx, same origin.
CLIENT_APP_ORIGIN=http://localhost:5173
