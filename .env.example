# Copy to .env to override anything below. Every value already has a default in
# docker-compose.yml, so an empty .env, or none at all, runs the stack as documented.
# Passwords are not set here: they are files under secrets/, see scripts/init-secrets.ps1.

# Profiles to start on a plain `docker compose up`. Without it only the application runs;
# "observability" adds Prometheus, Loki, Tempo and Grafana, "tools" adds pgAdmin.
# COMPOSE_PROFILES=observability,tools

# Environment of the four .NET services. docker-compose.override.yml, which compose loads on
# its own, defaults it to Development; scripts/deploy.ps1 skips the override and runs Production.
# ASPNETCORE_ENVIRONMENT=Development

# Images of our own services: ${IMAGE_REGISTRY}/<service>:<tag>. scripts/deploy.ps1 sets these
# per release; a plain `docker compose up --build` builds and runs weakapphandler/<service>:latest.
# IMAGE_REGISTRY is a local prefix by default, or a registry path such as
# ghcr.io/<owner>/weakapphandler to run the images CI published.
# IMAGE_REGISTRY=weakapphandler
# IMAGE_TAG=latest
# A service tag wins over IMAGE_TAG for that one service.
# INGESTOR_TAG=
# PROCESSOR_TAG=
# NOTIFICATIONS_TAG=
# GATEWAY_TAG=
# FRONTEND_TAG=

# WeakApp, the unstable third-party API. Its API key is secrets/weakapp_api_key and has to stay
# "supersecret": the vendored service accepts no other value.
# WEAKAPP_PORT=8080
# WEAKAPP_ENVIRONMENT=Development

# RabbitMQ. Host ports only; inside the backend network the broker is always rabbitmq:5672.
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# RABBITMQ_USER=guest

# PostgreSQL. Host port only; inside the backend network the database is always postgres:5432.
# POSTGRES_USER owns the schema and runs the migrations; GATEWAY_DB_USER is the read-only role
# db/init creates on the first start.
# POSTGRES_PORT=5432
# POSTGRES_DB=weakapphandler
# POSTGRES_USER=processor
# GATEWAY_DB_USER=gateway

# pgAdmin, the database UI (profile "tools").
# PGADMIN_PORT=5050
# PGADMIN_EMAIL=admin@weakapphandler.com

# Host ports of our own services. Inside the network every one of them listens on 8080.
# INGESTOR_PORT=5227
# PROCESSOR_PORT=5242
# GATEWAY_PORT=5243
# NOTIFICATIONS_PORT=5244
# FRONTEND_PORT=5180

# Observability (profile "observability").
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# TEMPO_PORT=3200
# TEMPO_OTLP_PORT=4317
# GRAFANA_PORT=3000
# GRAFANA_USER=admin

# Browser origin allowed to open a SignalR connection to the notification service. Only the
# Vite dev server needs it; the container talks to the hub through nginx, same origin.
# CLIENT_APP_ORIGIN=http://localhost:5173
