# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored; never commit real secrets.
#
# This file will grow as later tasks introduce each service's configuration

COMPOSE_PROJECT_NAME=weakapphandler
WEAKAPP_PORT=8080

# RabbitMQ. Host ports only — inside the backend network the broker is always rabbitmq:5672.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# PostgreSQL. Host port only — inside the backend network the database is always postgres:5432.
POSTGRES_PORT=5432
POSTGRES_DB=weakapphandler
POSTGRES_USER=processor
POSTGRES_PASSWORD=processor_password
