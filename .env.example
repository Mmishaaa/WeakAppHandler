# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored; never commit real secrets.
#
# This file will grow as later tasks introduce each service's configuration
# (Auth, JWT signing, etc. per PRD §11).

COMPOSE_PROJECT_NAME=weakapphandler

# WeakApp (third_party/weak-app) -- see THIRD_PARTY.md
WEAKAPP_PORT=8080

# PostgreSQL -- superuser credentials for the compose-managed instance only.
# Per-service roles (processor/auth/...) are created by deploy/postgres/init/ and match
# the placeholder credentials already hardcoded in each service's appsettings.json;
# TASK-043 replaces these with real least-privilege roles.
POSTGRES_DB=weakapphandler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# RabbitMQ -- only ports are configurable here, deliberately. RABBITMQ_DEFAULT_USER/PASS are
# NOT listed because they would be silently ignored: once rabbitmq.conf sets
# `management.load_definitions`, RabbitMQ logs "Will not seed default virtual host and user:
# have definitions to load..." and skips default-user creation entirely, so those two env vars
# have no effect at all. The local-dev user therefore lives in deploy/rabbitmq/definitions.json
# (guest/guest, administrator on "/"); TASK-043 removes it in favour of one least-privilege
# user per service.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
