<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- Test-only. Matches the 10.0.11 pin every other ASP.NET Core-family package in this file
         uses; unlike those, this one could not be verified against NuGet in the session that added
         it (see TASK-031's progress.txt entry) - confirm on the next `dotnet restore` before relying
         on it. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <!-- Pinned to 8.5.10, the last 8.x release, rather than any 9.x: starting with MassTransit 9,
         CreateBus throws MassTransit.ConfigurationException ("License must be specified with
         SetLicense/SetLicenseLocation or ... MT_LICENSE/MT_LICENSE_PATH") unless a commercial
         license is configured - reproduced for real against RabbitMQ in every messaging service
         (Ingestor/Processor/Gateway/Notification), not just a config gap. 8.5.10 has no such gate. -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <!-- Pinned to the version MassTransit.RabbitMQ 8.5.10 resolves transitively, so the tests that
         inspect the broker directly speak to it through the exact same client the bus uses. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Matches the version Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 itself resolves
         transitively - tools/ReplayIngestedMessage uses the plain ADO.NET client directly, with no
         EF Core involved, so this needs its own explicit central pin. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.2" />
    <!-- TASK-042: HotChocolate.AspNetCore brings in HotChocolate.Authorization (the [Authorize]
         attribute and the @authorize directive) but not the ASP.NET Core-backed handler that
         evaluates the named policies, nor the AddAuthorization() builder call that installs it -
         both live in this separate package. Same version as the rest of the HotChocolate graph. -->
    <PackageVersion Include="HotChocolate.AspNetCore.Authorization" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.Data" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.Data.EntityFramework" Version="16.6.2" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- TASK-030: request-level validation for the Notification admin REST surface. Pinned as a
         plain library reference (no ASP.NET Core auto-validation integration package - the author
         deprecated FluentValidation.AspNetCore - so validators are invoked explicitly in the
         controller, converting failures into the same ValidationProblem shape TASK-017's config
         PUT endpoint already established). -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
