{
  "id": null,
  "uid": "weakapphandler-overview",
  "title": "WeakAppHandler Overview",
  "description": "PRD F10: WeakApp failure rate, circuit-breaker state, and the other pipeline metrics each service exports. Provisioned automatically (TASK-045) - no manual import required.",
  "tags": ["weakapphandler"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "WeakApp poll outcomes",
      "description": "Poll outcomes by cause (PRD F10). A rising non-Success rate is WeakApp's failure rate.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(ingestor_poll_outcomes_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Ingestor circuit-breaker state",
      "description": "0=Closed, 1=HalfOpen, 2=Open, 3=Isolated (IngestorMetrics).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Closed", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "HalfOpen", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "Open", "color": "red" } } },
            { "type": "value", "options": { "3": { "text": "Isolated", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ingestor_circuit_breaker_state",
          "legendFormat": "state",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "WeakApp poll latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ingestor_poll_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queue consumption rate",
      "description": "MassTransit's own receive rate per destination queue (TASK-044's queue-consumption-rate metric).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (messaging_masstransit_destination) (rate(messaging_masstransit_receive_total[5m]))",
          "legendFormat": "{{messaging_masstransit_destination}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Processor processing latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, message_type) (rate(processor_processing_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{message_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Deduplicated vs dead-lettered messages",
      "description": "Cumulative counts since process start (ProcessorMetrics).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "processor_messages_deduplicated_total",
          "legendFormat": "Deduplicated",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "processor_messages_dead_lettered_total",
          "legendFormat": "Dead-lettered",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Alerts raised / resolved",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (severity) (rate(notification_alerts_raised_total[5m]))",
          "legendFormat": "raised: {{severity}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (severity) (rate(notification_alerts_resolved_total[5m]))",
          "legendFormat": "resolved: {{severity}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "GraphQL request duration (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_status_code) (rate(gateway_graphql_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{http_status_code}}",
          "refId": "A"
        }
      ]
    }
  ]
}
