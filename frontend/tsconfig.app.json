{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Generated by `npm run codegen` (see codegen.ts) and never hand-edited - same reason
  // eslint.config.js ignores it. Excluded from this project's own root file set rather than
  // type-checked in isolation: with no real .graphql documents yet, its unused top-level export
  // would fail noUnusedLocals until something actually imports it, at which point it is checked
  // normally as that file's own dependency.
  "exclude": ["src/gql"]
}
