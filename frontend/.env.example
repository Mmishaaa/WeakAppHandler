# Copy to .env.local (gitignored by Vite's default .gitignore) and adjust for your environment.
# Defaults in src/shared/config/runtimeConfig.ts already match the Gateway/Notification `https`
# dotnet run profiles, so this file only needs to be copied when those differ (e.g. once TASK-047
# puts both services behind docker-compose).

# Gateway GraphQL endpoint: HTTP for queries/mutations, WS for the onReadingStored subscription.
VITE_GATEWAY_GRAPHQL_HTTP_URL=https://localhost:7069/graphql
VITE_GATEWAY_GRAPHQL_WS_URL=wss://localhost:7069/graphql

# Notification Service's SignalR hub for alert raised/resolved events.
VITE_NOTIFICATION_ALERTS_HUB_URL=https://localhost:7031/hubs/alerts
